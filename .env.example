# Django Core
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-this-in-production-to-a-secure-random-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Render Environment (automatically populated by Render)
# RENDER_EXTERNAL_HOSTNAME=learnlens-backend.onrender.com
# PORT=10000

# Database (optional for local SQLite, required for Render PostgreSQL)
# DATABASE_URL=postgres://user:password@hostname:5432/learnlens_db

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=True

# Firebase Admin SDK Configuration
# Path to service account JSON file:
FIREBASE_CREDENTIALS_PATH=
# Or raw JSON string of service account:
FIREBASE_CREDENTIALS_JSON=

# OpenAI SDK Configuration
OPENAI_API_KEY=sk-placeholder-replace-with-your-openai-key
