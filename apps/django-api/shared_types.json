{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LearnLensSharedContracts",
  "description": "Strict contract definitions for LearnLens educational diagnostic engine. Adhered to by both API and AI/Math engine developers.",
  "version": "1.0.0",
  "definitions": {
    "AssessmentSubmissionPayload": {
      "type": "object",
      "description": "Exact JSON payload expected by POST /api/assessments/submit/",
      "required": [
        "assessment_id",
        "student_id",
        "domain",
        "responses"
      ],
      "properties": {
        "assessment_id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for the diagnostic assessment session."
        },
        "student_id": {
          "type": "string",
          "description": "Unique identifier for the student/learner."
        },
        "domain": {
          "type": "string",
          "description": "Educational domain (e.g., 'algebra', 'mechanics', 'molecular_biology')."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp of assessment submission."
        },
        "responses": {
          "type": "array",
          "description": "List of student responses across assessment items.",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "item_id",
              "user_answer",
              "time_spent_seconds"
            ],
            "properties": {
              "item_id": {
                "type": "string",
                "description": "Unique identifier for the diagnostic question/item."
              },
              "user_answer": {
                "type": ["string", "number", "boolean", "array"],
                "description": "The response given by the learner."
              },
              "is_correct": {
                "type": ["boolean", "null"],
                "description": "Pre-graded correctness flag if evaluated client-side, otherwise null."
              },
              "time_spent_seconds": {
                "type": "number",
                "minimum": 0,
                "description": "Time spent answering this item in seconds."
              },
              "hints_used": {
                "type": "integer",
                "minimum": 0,
                "default": 0,
                "description": "Number of hints requested for this item."
              },
              "confidence_level": {
                "type": "string",
                "enum": ["low", "medium", "high"],
                "description": "Learner's self-reported confidence."
              }
            }
          }
        },
        "metadata": {
          "type": "object",
          "description": "Optional contextual session metadata.",
          "properties": {
            "grade_level": {
              "type": "string"
            },
            "curriculum_standard": {
              "type": "string"
            },
            "client_version": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "LLMDiagnosticResponse": {
      "type": "object",
      "description": "Exact JSON payload that the LLM engine must return upon diagnostic evaluation.",
      "required": [
        "assessment_id",
        "student_id",
        "domain",
        "mastery_score",
        "latent_ability_theta",
        "learning_gaps",
        "misconceptions",
        "recommended_interventions",
        "summary_narrative"
      ],
      "properties": {
        "assessment_id": {
          "type": "string",
          "format": "uuid",
          "description": "Matches the assessment_id from submission."
        },
        "student_id": {
          "type": "string",
          "description": "Matches the student_id from submission."
        },
        "domain": {
          "type": "string",
          "description": "The diagnostic domain evaluated."
        },
        "mastery_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Normalized holistic mastery level between 0.0 and 1.0."
        },
        "latent_ability_theta": {
          "type": "number",
          "description": "Item Response Theory (IRT) estimated latent ability parameter (typically -3.0 to +3.0)."
        },
        "learning_gaps": {
          "type": "array",
          "description": "Identified conceptual weaknesses and deficiencies.",
          "items": {
            "type": "object",
            "required": [
              "concept_id",
              "concept_name",
              "severity",
              "description",
              "evidence_item_ids"
            ],
            "properties": {
              "concept_id": {
                "type": "string",
                "description": "Unique concept or sub-skill identifier."
              },
              "concept_name": {
                "type": "string",
                "description": "Human-readable label of the deficient concept."
              },
              "severity": {
                "type": "string",
                "enum": ["critical", "moderate", "minor"],
                "description": "Impact of this gap on domain mastery progression."
              },
              "description": {
                "type": "string",
                "description": "Detailed explanation of why this is considered a gap."
              },
              "evidence_item_ids": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Item IDs supporting this diagnosis."
              }
            }
          }
        },
        "misconceptions": {
          "type": "array",
          "description": "Cognitive fallacies, invalid heuristics, or persistent erroneous mental models.",
          "items": {
            "type": "object",
            "required": [
              "concept_id",
              "identified_misconception",
              "explanation",
              "detected_in_items"
            ],
            "properties": {
              "concept_id": {
                "type": "string",
                "description": "Concept where the misconception occurred."
              },
              "identified_misconception": {
                "type": "string",
                "description": "Label of the erroneous mental model."
              },
              "explanation": {
                "type": "string",
                "description": "Mechanistic reason why the learner's thinking was flawed."
              },
              "detected_in_items": {
                "type": "array",
                "items": { "type": "string" },
                "description": "List of item IDs exhibiting this misconception pattern."
              }
            }
          }
        },
        "recommended_interventions": {
          "type": "array",
          "description": "Prescribed pedagogical remediation actions tailored to the learner.",
          "items": {
            "type": "object",
            "required": [
              "intervention_id",
              "title",
              "type",
              "priority",
              "actionable_steps"
            ],
            "properties": {
              "intervention_id": {
                "type": "string",
                "description": "Unique identifier for this recommended intervention."
              },
              "title": {
                "type": "string",
                "description": "Short heading for the learning intervention."
              },
              "type": {
                "type": "string",
                "enum": ["remedial_lesson", "practice_drill", "conceptual_reframing", "scaffolded_walkthrough"],
                "description": "Pedagogical format of the intervention."
              },
              "priority": {
                "type": "string",
                "enum": ["high", "medium", "low"],
                "description": "Urgency of intervention."
              },
              "actionable_steps": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Concrete steps the learner or instructor should execute."
              }
            }
          }
        },
        "summary_narrative": {
          "type": "string",
          "description": "Synthesized qualitative diagnostic paragraph for student and educator."
        }
      },
      "additionalProperties": false
    }
  },
  "examples": {
    "sample_post_assessments_submit": {
      "assessment_id": "a9d7240c-99fb-4a87-b6bb-f8876c6e7a20",
      "student_id": "std_89234",
      "domain": "algebraic_equations",
      "timestamp": "2026-09-25T07:10:00Z",
      "responses": [
        {
          "item_id": "item_alg_001",
          "user_answer": "x = 4",
          "is_correct": true,
          "time_spent_seconds": 32.5,
          "hints_used": 0,
          "confidence_level": "high"
        },
        {
          "item_id": "item_alg_002",
          "user_answer": "x = -2",
          "is_correct": false,
          "time_spent_seconds": 88.0,
          "hints_used": 1,
          "confidence_level": "low"
        }
      ],
      "metadata": {
        "grade_level": "Grade 9",
        "curriculum_standard": "CCSS.MATH.CONTENT.HSA.REI.B.3",
        "client_version": "v1.2.0"
      }
    },
    "sample_llm_diagnostic_response": {
      "assessment_id": "a9d7240c-99fb-4a87-b6bb-f8876c6e7a20",
      "student_id": "std_89234",
      "domain": "algebraic_equations",
      "mastery_score": 0.65,
      "latent_ability_theta": 0.42,
      "learning_gaps": [
        {
          "concept_id": "neg_sign_distrib",
          "concept_name": "Negative Sign Distribution in Multi-Step Equations",
          "severity": "critical",
          "description": "Learner fails to distribute negative signs across parentheses prior to isolating variables.",
          "evidence_item_ids": ["item_alg_002"]
        }
      ],
      "misconceptions": [
        {
          "concept_id": "neg_sign_distrib",
          "identified_misconception": "Selective Sign Flipping",
          "explanation": "Student flipped the sign of the first term inside parentheses but left the second term unaltered.",
          "detected_in_items": ["item_alg_002"]
        }
      ],
      "recommended_interventions": [
        {
          "intervention_id": "intv_01_distrib_prop",
          "title": "Interactive Distributive Property Visualizer",
          "type": "conceptual_reframing",
          "priority": "high",
          "actionable_steps": [
            "Review visual area models representing -(a + b)",
            "Complete 5 targeted 1-step sign distribution practice drills",
            "Retest with multi-step parenthetical equations"
          ]
        }
      ],
      "summary_narrative": "The learner demonstrates solid baseline competence in standard linear solving operations, but displays a critical cognitive misconception during sign distribution when parentheses are preceded by a subtraction operator."
    }
  }
}
